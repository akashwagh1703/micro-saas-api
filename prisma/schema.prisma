generator client {
  provider      = "prisma-client-js"
  // "native" for local dev; "rhel-openssl-3.0.x" for Vercel/AWS Lambda runtime.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  // Pooled connection (e.g. Neon pooler) used by the app at runtime.
  url       = env("DATABASE_URL")
  // Direct (non-pooled) connection used for migrations. Falls back to DATABASE_URL
  // when DIRECT_URL is unset (e.g. local dev / Render).
  directUrl = env("DIRECT_URL")
}

model User {
  id              Int       @id @default(autoincrement())
  name            String
  email           String    @unique
  emailVerifiedAt DateTime? @map("email_verified_at")
  password        String
  rememberToken   String?   @map("remember_token") @db.VarChar(100)
  createdAt       DateTime? @default(now()) @map("created_at")
  updatedAt       DateTime? @updatedAt @map("updated_at")

  // Platform billing (14-day trial, then Razorpay monthly/yearly)
  trialEndsAt            DateTime  @map("trial_ends_at")
  subscriptionStatus     String    @default("trial") @map("subscription_status") @db.VarChar(20)
  subscriptionPlan       String?   @map("subscription_plan") @db.VarChar(20)
  razorpayCustomerId     String?   @map("razorpay_customer_id") @db.VarChar(64)
  razorpaySubscriptionId String?   @map("razorpay_subscription_id") @db.VarChar(64)
  currentPeriodEnd       DateTime? @map("current_period_end")

  whatsAppAccount     WhatsAppAccount?
  contacts            Contact[]
  conversations       Conversation[]
  messages            Message[]
  workflows           Workflow[]
  workflowExecutions  WorkflowExecution[]
  settings            UserSetting[]
  activities          Activity[]
  tokens              PersonalAccessToken[]
  leads               Lead[]

  @@map("users")
}

model PersonalAccessToken {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  name       String
  token      String    @unique @db.VarChar(64)
  abilities  String?
  lastUsedAt DateTime? @map("last_used_at")
  expiresAt  DateTime? @map("expires_at")
  createdAt  DateTime? @default(now()) @map("created_at")
  updatedAt  DateTime? @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("personal_access_tokens")
}

model WhatsAppAccount {
  id                 Int       @id @default(autoincrement())
  userId             Int       @unique @map("user_id")
  accessToken        String?   @map("access_token")
  phoneNumberId      String?   @map("phone_number_id")
  businessAccountId  String?   @map("business_account_id")
  verifyToken        String?   @map("verify_token")
  appSecret          String?   @map("app_secret")
  displayPhoneNumber String?   @map("display_phone_number")
  isConnected        Boolean   @default(false) @map("is_connected")
  connectedAt        DateTime? @map("connected_at")
  createdAt          DateTime? @default(now()) @map("created_at")
  updatedAt          DateTime? @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@map("whats_app_accounts")
}

model Contact {
  id            Int       @id @default(autoincrement())
  userId        Int       @map("user_id")
  name          String?
  phone         String
  email         String?
  tags          Json?
  notes         String?
  lastMessageAt DateTime? @map("last_message_at")
  createdAt     DateTime? @default(now()) @map("created_at")
  updatedAt     DateTime? @updatedAt @map("updated_at")

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation       Conversation?
  messages           Message[]
  workflowExecutions WorkflowExecution[]

  @@unique([userId, phone])
  @@index([userId, lastMessageAt])
  @@map("contacts")
}

model Conversation {
  id                Int       @id @default(autoincrement())
  userId            Int       @map("user_id")
  contactId         Int       @unique @map("contact_id")
  whatsAppAccountId Int?      @map("whats_app_account_id")
  unreadCount       Int       @default(0) @map("unread_count")
  lastMessageAt     DateTime? @map("last_message_at")
  createdAt         DateTime? @default(now()) @map("created_at")
  updatedAt         DateTime? @updatedAt @map("updated_at")

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact            Contact             @relation(fields: [contactId], references: [id], onDelete: Cascade)
  whatsAppAccount    WhatsAppAccount?    @relation(fields: [whatsAppAccountId], references: [id], onDelete: SetNull)
  messages           Message[]
  workflowExecutions WorkflowExecution[]

  @@index([userId, lastMessageAt])
  @@map("conversations")
}

model Message {
  id             Int       @id @default(autoincrement())
  userId         Int       @map("user_id")
  conversationId Int       @map("conversation_id")
  contactId      Int       @map("contact_id")
  direction      String
  content        String
  waMessageId    String?   @map("wa_message_id")
  status         String    @default("pending")
  metadata       Json?
  createdAt      DateTime? @default(now()) @map("created_at")
  updatedAt      DateTime? @updatedAt @map("updated_at")

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation       Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  contact            Contact             @relation(fields: [contactId], references: [id], onDelete: Cascade)
  workflowExecutions WorkflowExecution[]

  @@index([conversationId, createdAt])
  @@index([userId, waMessageId])
  @@map("messages")
}

model Workflow {
  id               Int       @id @default(autoincrement())
  userId           Int       @map("user_id")
  name             String
  description      String?
  status           String    @default("draft")
  isActive         Boolean   @default(false) @map("is_active")
  triggerType      String    @default("message_received") @map("trigger_type")
  sourceTemplate   String?   @map("source_template")
  businessCategory String?   @map("business_category")
  useCase          String?   @map("use_case")
  isArchived       Boolean   @default(false) @map("is_archived")
  definition       Json?
  createdAt        DateTime? @default(now()) @map("created_at")
  updatedAt        DateTime? @updatedAt @map("updated_at")

  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  executions WorkflowExecution[]

  @@index([userId, status])
  @@index([userId, sourceTemplate])
  @@index([userId, businessCategory, isArchived])
  @@map("workflows")
}

model WorkflowExecution {
  id             Int       @id @default(autoincrement())
  userId         Int       @map("user_id")
  workflowId     Int       @map("workflow_id")
  contactId      Int?      @map("contact_id")
  conversationId Int?      @map("conversation_id")
  messageId      Int?      @map("message_id")
  status         String    @default("pending")
  context        Json?
  errorMessage   String?   @map("error_message")
  startedAt      DateTime? @map("started_at")
  completedAt    DateTime? @map("completed_at")
  createdAt      DateTime? @default(now()) @map("created_at")
  updatedAt      DateTime? @updatedAt @map("updated_at")

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  workflow     Workflow       @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  contact      Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  conversation Conversation?  @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  message      Message?       @relation(fields: [messageId], references: [id], onDelete: SetNull)
  logs         ExecutionLog[]

  @@index([userId, workflowId, createdAt])
  @@map("workflow_executions")
}

model ExecutionLog {
  id                  Int       @id @default(autoincrement())
  workflowExecutionId Int       @map("workflow_execution_id")
  nodeId              String    @map("node_id")
  nodeType            String    @map("node_type")
  status              String    @default("pending")
  input               Json?
  output              Json?
  errorMessage        String?   @map("error_message")
  durationMs          Int?      @map("duration_ms")
  createdAt           DateTime? @default(now()) @map("created_at")
  updatedAt           DateTime? @updatedAt @map("updated_at")

  execution WorkflowExecution @relation(fields: [workflowExecutionId], references: [id], onDelete: Cascade)

  @@index([workflowExecutionId, createdAt])
  @@map("execution_logs")
}

model UserSetting {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  key         String
  value       String?
  isEncrypted Boolean   @default(false) @map("is_encrypted")
  createdAt   DateTime? @default(now()) @map("created_at")
  updatedAt   DateTime? @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@map("user_settings")
}

model Activity {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  type        String
  title       String
  description String?
  metadata    Json?
  createdAt   DateTime? @default(now()) @map("created_at")
  updatedAt   DateTime? @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("activities")
}

model Lead {
  id               Int       @id @default(autoincrement())
  userId           Int       @map("user_id")
  channel          String    @default("whatsapp") @db.VarChar(20)
  status           String    @default("new") @db.VarChar(20)
  contactId        Int?      @map("contact_id")
  conversationId   Int?      @map("conversation_id")
  workflowId       Int?      @map("workflow_id")
  executionId      Int?      @map("execution_id")
  name             String?
  phone            String?
  username         String?
  sourceMessage    String?   @map("source_message")
  collected        Json?
  notes            String?
  createdAt        DateTime? @default(now()) @map("created_at")
  updatedAt        DateTime? @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
  @@index([userId, channel, createdAt])
  @@map("leads")
}
