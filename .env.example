# Application
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# PostgreSQL connection string used by Prisma (and pg-boss when QUEUE_DRIVER=pgboss).
#
# Render Postgres — two URLs in the dashboard:
#   • Internal  (@dpg-xxx-a/...)     → API service on Render ONLY (not from your laptop)
#   • External  (@dpg-xxx-a.region-postgres.render.com/...?sslmode=require) → local migrate deploy
#
# Local dev against Render DB: paste the EXTERNAL URL into both DATABASE_URL and DIRECT_URL below.
# Migrate on Render without local access: open Render → micro-saas-api → Shell → npx prisma migrate deploy
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/workflow_automation?schema=public
# Direct (non-pooled) connection used only by `prisma migrate`. On Neon use the
# unpooled string; locally/Render set it to the same value as DATABASE_URL.
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:5432/workflow_automation?schema=public

# Background work driver:
#   pgboss = in-process PostgreSQL queue + worker (always-on hosts: Render, Docker, local)
#   sync   = run jobs inline during the request (serverless hosts: Vercel)
QUEUE_DRIVER=pgboss

# 32-byte key (base64 or hex) used to encrypt WhatsApp/AI secrets at rest (AES-256-GCM).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# bcrypt cost factor for password hashing.
BCRYPT_ROUNDS=12

# WhatsApp Cloud API
WHATSAPP_GRAPH_VERSION=v21.0

# AI defaults (per-user keys are stored encrypted in user_settings)
AI_DEFAULT_PROVIDER=openrouter
AI_DEFAULT_MODEL=openai/gpt-4o-mini
