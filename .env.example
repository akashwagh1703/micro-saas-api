# Application
NODE_ENV=development
PORT=3000
APP_URL=https://api.example.com
# Portal origin for CORS — must be the app URL, NOT the API URL
CORS_ORIGINS=https://app.example.com,https://www.example.com,http://localhost:*
# Allow http://localhost:* for Expo web / local portal dev (set true on live API if needed)
CORS_ALLOW_LOCALHOST=true
WEBSITE_URL=https://www.example.com
PORTAL_URL=https://app.example.com

# Website lead emails (demo confirmation + sales notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@example.com
SALES_EMAIL=sales@example.com

# Platform super-admin — full access + user management dashboard
SUPER_ADMIN_EMAILS=admin@example.com

# PostgreSQL connection string used by Prisma (and pg-boss when QUEUE_DRIVER=pgboss).
DATABASE_URL=postgresql://user:password@localhost:5432/autowave
DIRECT_URL=postgresql://user:password@localhost:5432/autowave

# Background work driver:
#   pgboss = in-process PostgreSQL queue + worker (always-on hosts: Render, Docker, local)
#   sync   = run jobs inline during the request (serverless hosts: Vercel)
QUEUE_DRIVER=pgboss

# 32-byte key (base64 or hex) used to encrypt WhatsApp/AI secrets at rest (AES-256-GCM).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# bcrypt cost factor for password hashing.
BCRYPT_ROUNDS=12

# DEV ONLY: accept WhatsApp/Instagram webhooks even when no Meta app_secret is
# configured (signatures are NOT verified). Ignored in production. Leave unset/false
# in any shared or live environment so forged inbound messages are rejected.
ALLOW_UNVERIFIED_WEBHOOKS=false

# Rate limiting (in-memory per process — use Redis for multi-instance deploy)
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_WEBHOOK_MAX=120
RATE_LIMIT_WEBSITE_LEAD_MAX=5
RATE_LIMIT_WINDOW_MS=60000

# Protect /up/metrics in production (send header: X-Metrics-Token: <value>)
METRICS_TOKEN=

# WhatsApp Cloud API
WHATSAPP_GRAPH_VERSION=v21.0

# AI defaults (per-user keys are stored encrypted in user_settings)
AI_DEFAULT_PROVIDER=openrouter
AI_DEFAULT_MODEL=nvidia/nemotron-3.5-content-safety:free

# CareerAI Bot — resume storage and daily digest (business type: career_ai)
CAREER_STORAGE_PATH=./storage/career
# Resume OCR for photos (and scanned PDFs when CAREER_PDF_OCR_ENABLED=true)
CAREER_OCR_ENABLED=true
CAREER_PDF_OCR_ENABLED=true
CAREER_PDF_OCR_MAX_PAGES=3
CAREER_EXTRACT_MIN_CHARS=80
# Drop parsed fields not found in extracted resume text (anti-hallucination, R2)
CAREER_PARSE_VALIDATION_ENABLED=true
# WhatsApp confirm step before saving parsed resume to profile (R3)
CAREER_PARSE_CONFIRM_ENABLED=true
# Signed download links sent on WhatsApp (hours, default 72). Uses APP_URL — not raw MinIO URLs.
CAREER_SHARE_TTL_HOURS=72
CAREER_DIGEST_ENABLED=true
CAREER_DIGEST_TIMEZONE=Asia/Kolkata
CAREER_DIGEST_HOUR=8
CAREER_DIGEST_HOUR_UTC=8
# Max CareerAI bot WhatsApp replies per contact per minute (default 20)
CAREER_RATE_LIMIT_PER_MINUTE=20
# Monthly AI token cap per tenant (0 = unlimited)
CAREER_AI_MONTHLY_TOKEN_LIMIT=500000
# AI rerank on top rule-scored jobs (final = 0.6 rule + 0.4 AI)
CAREER_MATCH_AI_RERANK_ENABLED=true
CAREER_MATCH_AI_RERANK_TOP_N=30
# Feedback loop: boost/downrank from apply, dismiss, cover letter actions
CAREER_MATCH_LEARNING_ENABLED=true
CAREER_MATCH_LEARNING_MAX_ADJUST=15
# Auto re-match when operator updates roles/skills/location on a complete profile
CAREER_AUTO_REMATCH_ON_PROFILE_UPDATE=true
# Zero-match playbook: fetch targeted jobs when run from portal
CAREER_ZERO_MATCH_AUTO_FETCH=true

# CareerAI — dual job sources (both run on every Fetch / Refresh when keys are set)
# Adzuna: India-focused listings — https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# JSearch (RapidAPI): Google Jobs aggregator — https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
JSEARCH_RAPIDAPI_KEY=
JSEARCH_DEFAULT_COUNTRY=in
JSEARCH_MAX_PAGES=1

# Optional custom feeds (same JSON shape as linkedin.job-source expects)
# LINKEDIN_JOBS_API_URL=
# LINKEDIN_JOBS_API_KEY=
# NAUKRI_JOBS_API_URL=
# NAUKRI_JOBS_API_KEY=

# CareerAI — MinIO object storage for resumes (S3-compatible API)
# MINIO_ENDPOINT must use port 9000 (S3 API), not 9001 (web console).
MINIO_ENDPOINT=http://localhost:9000
MINIO_FORCE_PATH_STYLE=true
MINIO_BUCKET=autowave-docs
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_REGION=us-east-1

# Platform billing (14-day trial, then Razorpay monthly/yearly)
# Set BILLING_ENABLED=true in production once Razorpay is configured.
BILLING_ENABLED=false
BILLING_TRIAL_DAYS=14
PLATFORM_PRICE_MONTHLY_INR=499
PLATFORM_PRICE_YEARLY_INR=4999

# Razorpay — create two subscription plans in Razorpay Dashboard, paste plan IDs here.
# Webhook URL: {APP_URL}/api/webhook/razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_MONTHLY=
RAZORPAY_PLAN_YEARLY=
