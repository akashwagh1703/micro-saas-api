generator client {
  provider      = "prisma-client-js"
  // "native" for local dev; "rhel-openssl-3.0.x" for Vercel/AWS Lambda runtime.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  // Pooled connection (e.g. Neon pooler) used by the app at runtime.
  url       = env("DATABASE_URL")
  // Direct (non-pooled) connection used for migrations. Falls back to DATABASE_URL
  // when DIRECT_URL is unset (e.g. local dev / Render).
  directUrl = env("DIRECT_URL")
}

model User {
  id              Int       @id @default(autoincrement())
  name            String
  email           String    @unique
  emailVerifiedAt DateTime? @map("email_verified_at")
  password        String
  rememberToken   String?   @map("remember_token") @db.VarChar(100)
  createdAt       DateTime? @default(now()) @map("created_at")
  updatedAt       DateTime? @updatedAt @map("updated_at")

  // Platform billing (trial, then Razorpay / UPI monthly/yearly)
  trialEndsAt            DateTime  @map("trial_ends_at")
  subscriptionStatus     String    @default("trial") @map("subscription_status") @db.VarChar(32)
  subscriptionPlan       String?   @map("subscription_plan") @db.VarChar(20)
  razorpayCustomerId     String?   @map("razorpay_customer_id") @db.VarChar(64)
  razorpaySubscriptionId String?   @map("razorpay_subscription_id") @db.VarChar(64)
  currentPeriodEnd       DateTime? @map("current_period_end")
  subscriptionCancelAtPeriodEnd Boolean @default(false) @map("subscription_cancel_at_period_end")
  // Idempotency for subscription lifecycle emails/pushes (stores the endsAt we already notified for)
  billingExpiringNotifiedFor DateTime? @map("billing_expiring_notified_for")
  billingExpiredNotifiedFor  DateTime? @map("billing_expired_notified_for")

  // Website add-on (brochure publish) — independent of platform subscription
  // none | pending_verification | active | expired | cancelled
  websiteSubscriptionStatus String    @default("none") @map("website_subscription_status") @db.VarChar(32)
  websiteSubscriptionPlan   String?   @map("website_subscription_plan") @db.VarChar(20)
  websiteCurrentPeriodEnd   DateTime? @map("website_current_period_end")

  whatsAppAccount     WhatsAppAccount?
  instagramAccount    InstagramAccount?
  contacts            Contact[]
  conversations       Conversation[]
  messages            Message[]
  workflows           Workflow[]
  workflowExecutions  WorkflowExecution[]
  settings            UserSetting[]
  activities          Activity[]
  tokens              PersonalAccessToken[]
  leads               Lead[]
  careerProfiles      CareerProfile[]
  careerResumes       CareerResume[]
  careerJobs          CareerJob[]
  careerJobMatches    CareerJobMatch[]
  careerMatchFeedback CareerMatchFeedback[]
  careerApplications  CareerApplication[]
  careerCoverLetters  CareerCoverLetter[]
  careerNotifications CareerNotification[]
  careerAuditLogs     CareerAuditLog[]
  billingTransactions BillingTransaction[]
  paymentSubmissions  PaymentSubmission[]
  platformAuditLogs   PlatformAuditLog[] @relation("PlatformAuditTarget")
  integrationCredentials IntegrationCredential[]
  userWorkflowStates  UserWorkflowState[]
  interactiveTemplates InteractiveMessageTemplate[]
  serviceResources    ServiceResource[]
  bookings            Booking[]
  ownerNotifications  OwnerNotification[]
  pushDeviceTokens    PushDeviceToken[]
  authEmailTokens     AuthEmailToken[]
  catalogSite         CatalogSite?
  catalogOrders       CatalogOrder[]

  @@map("users")
}

// One-time tokens for email verification and password reset (hashed at rest).
model AuthEmailToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  type      String    @db.VarChar(32)
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("auth_email_tokens")
}

model PersonalAccessToken {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  name       String
  token      String    @unique @db.VarChar(64)
  abilities  String?
  lastUsedAt DateTime? @map("last_used_at")
  expiresAt  DateTime? @map("expires_at")
  createdAt  DateTime? @default(now()) @map("created_at")
  updatedAt  DateTime? @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("personal_access_tokens")
}

model WhatsAppAccount {
  id                 Int       @id @default(autoincrement())
  userId             Int       @unique @map("user_id")
  accessToken        String?   @map("access_token")
  phoneNumberId      String?   @map("phone_number_id")
  businessAccountId  String?   @map("business_account_id")
  verifyToken        String?   @map("verify_token")
  appSecret          String?   @map("app_secret")
  displayPhoneNumber String?   @map("display_phone_number")
  isConnected        Boolean   @default(false) @map("is_connected")
  connectedAt        DateTime? @map("connected_at")
  createdAt          DateTime? @default(now()) @map("created_at")
  updatedAt          DateTime? @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@map("whats_app_accounts")
}

model InstagramAccount {
  id              Int       @id @default(autoincrement())
  userId          Int       @unique @map("user_id")
  instagramUserId String?   @map("instagram_user_id")
  pageId          String?   @map("page_id")
  accessToken     String?   @map("access_token")
  verifyToken     String?   @map("verify_token")
  appSecret       String?   @map("app_secret")
  username        String?
  displayName     String?   @map("display_name")
  isConnected     Boolean   @default(false) @map("is_connected")
  connectedAt     DateTime? @map("connected_at")
  createdAt       DateTime? @default(now()) @map("created_at")
  updatedAt       DateTime? @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@map("instagram_accounts")
}

model Contact {
  id              Int       @id @default(autoincrement())
  userId          Int       @map("user_id")
  channel         String    @default("whatsapp") @db.VarChar(20)
  name            String?
  phone           String?
  instagramUserId String?   @map("instagram_user_id")
  username        String?
  email           String?
  tags            Json?
  notes           String?
  lastMessageAt   DateTime? @map("last_message_at")
  createdAt       DateTime? @default(now()) @map("created_at")
  updatedAt       DateTime? @updatedAt @map("updated_at")

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation       Conversation?
  messages           Message[]
  workflowExecutions WorkflowExecution[]
  careerProfile      CareerProfile?
  bookings           Booking[]
  catalogOrders      CatalogOrder[]

  @@unique([userId, phone])
  @@unique([userId, instagramUserId])
  @@index([userId, channel, lastMessageAt])
  @@index([userId, lastMessageAt])
  @@map("contacts")
}

model Conversation {
  id                  Int       @id @default(autoincrement())
  userId              Int       @map("user_id")
  contactId           Int       @unique @map("contact_id")
  channel             String    @default("whatsapp") @db.VarChar(20)
  whatsAppAccountId   Int?      @map("whats_app_account_id")
  instagramAccountId  Int?      @map("instagram_account_id")
  unreadCount         Int       @default(0) @map("unread_count")
  lastMessageAt       DateTime? @map("last_message_at")
  createdAt           DateTime? @default(now()) @map("created_at")
  updatedAt           DateTime? @updatedAt @map("updated_at")

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact            Contact             @relation(fields: [contactId], references: [id], onDelete: Cascade)
  whatsAppAccount    WhatsAppAccount?    @relation(fields: [whatsAppAccountId], references: [id], onDelete: SetNull)
  instagramAccount   InstagramAccount?   @relation(fields: [instagramAccountId], references: [id], onDelete: SetNull)
  messages           Message[]
  workflowExecutions WorkflowExecution[]
  bookings           Booking[]

  @@index([userId, channel, lastMessageAt])
  @@index([userId, lastMessageAt])
  @@map("conversations")
}

model Message {
  id                 Int       @id @default(autoincrement())
  userId             Int       @map("user_id")
  conversationId     Int       @map("conversation_id")
  contactId          Int       @map("contact_id")
  channel            String    @default("whatsapp") @db.VarChar(20)
  direction          String
  content            String
  waMessageId        String?   @map("wa_message_id")
  externalMessageId  String?   @map("external_message_id")
  status             String    @default("pending")
  metadata           Json?
  createdAt          DateTime? @default(now()) @map("created_at")
  updatedAt          DateTime? @updatedAt @map("updated_at")

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation       Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  contact            Contact             @relation(fields: [contactId], references: [id], onDelete: Cascade)
  workflowExecutions WorkflowExecution[]

  @@unique([userId, waMessageId])
  @@unique([userId, externalMessageId])
  @@index([conversationId, createdAt])
  @@index([userId, channel, createdAt])
  @@map("messages")
}

model Workflow {
  id               Int       @id @default(autoincrement())
  userId           Int       @map("user_id")
  name             String
  description      String?
  status           String    @default("draft")
  isActive         Boolean   @default(false) @map("is_active")
  triggerType      String    @default("message_received") @map("trigger_type")
  webhookToken     String?   @unique @map("webhook_token") @db.VarChar(64)
  scheduleCron     String?   @map("schedule_cron") @db.VarChar(64)
  scheduleTimezone String?   @default("UTC") @map("schedule_timezone") @db.VarChar(64)
  sourceTemplate   String?   @map("source_template")
  businessCategory String?   @map("business_category")
  useCase          String?   @map("use_case")
  isArchived       Boolean   @default(false) @map("is_archived")
  definition       Json?
  createdAt        DateTime? @default(now()) @map("created_at")
  updatedAt        DateTime? @updatedAt @map("updated_at")

  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  executions WorkflowExecution[]
  nodes      WorkflowNode[]

  @@index([userId, status])
  @@index([userId, sourceTemplate])
  @@index([userId, businessCategory, isArchived])
  @@map("workflows")
}

model WorkflowExecution {
  id             Int       @id @default(autoincrement())
  userId         Int       @map("user_id")
  workflowId     Int       @map("workflow_id")
  contactId      Int?      @map("contact_id")
  conversationId Int?      @map("conversation_id")
  messageId      Int?      @map("message_id")
  status         String    @default("pending")
  context        Json?
  errorMessage   String?   @map("error_message")
  startedAt      DateTime? @map("started_at")
  completedAt    DateTime? @map("completed_at")
  createdAt      DateTime? @default(now()) @map("created_at")
  updatedAt      DateTime? @updatedAt @map("updated_at")

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  workflow     Workflow       @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  contact      Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  conversation Conversation?  @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  message      Message?       @relation(fields: [messageId], references: [id], onDelete: SetNull)
  logs         ExecutionLog[]
  bookings     Booking[]

  @@index([userId, workflowId, createdAt])
  @@map("workflow_executions")
}

model ExecutionLog {
  id                  Int       @id @default(autoincrement())
  workflowExecutionId Int       @map("workflow_execution_id")
  nodeId              String    @map("node_id")
  nodeType            String    @map("node_type")
  status              String    @default("pending")
  input               Json?
  output              Json?
  errorMessage        String?   @map("error_message")
  durationMs          Int?      @map("duration_ms")
  createdAt           DateTime? @default(now()) @map("created_at")
  updatedAt           DateTime? @updatedAt @map("updated_at")

  execution WorkflowExecution @relation(fields: [workflowExecutionId], references: [id], onDelete: Cascade)

  @@index([workflowExecutionId, createdAt])
  @@map("execution_logs")
}

model UserSetting {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  key         String
  value       String?
  isEncrypted Boolean   @default(false) @map("is_encrypted")
  createdAt   DateTime? @default(now()) @map("created_at")
  updatedAt   DateTime? @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@map("user_settings")
}

model Activity {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  type        String
  title       String
  description String?
  metadata    Json?
  createdAt   DateTime? @default(now()) @map("created_at")
  updatedAt   DateTime? @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("activities")
}

model Lead {
  id               Int       @id @default(autoincrement())
  userId           Int       @map("user_id")
  channel          String    @default("whatsapp") @db.VarChar(20)
  status           String    @default("new") @db.VarChar(20)
  contactId        Int?      @map("contact_id")
  conversationId   Int?      @map("conversation_id")
  workflowId       Int?      @map("workflow_id")
  executionId      Int?      @map("execution_id")
  name             String?
  phone            String?
  username         String?
  sourceMessage    String?   @map("source_message")
  collected        Json?
  notes            String?
  createdAt        DateTime? @default(now()) @map("created_at")
  updatedAt        DateTime? @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
  @@index([userId, channel, createdAt])
  @@map("leads")
}

// --- CareerAI Bot (business type: career_ai) ---

model CareerProfile {
  id                 Int       @id @default(autoincrement())
  userId             Int       @map("user_id")
  contactId          Int       @unique @map("contact_id")
  fullName           String?   @map("full_name")
  email              String?
  phone              String?
  experience         Json?
  skills             Json?
  education          Json?
  certifications     Json?
  projects           Json?
  languages          Json?
  currentLocation    String?   @map("current_location")
  preferredLocations Json?     @map("preferred_locations")
  currentSalary      String?   @map("current_salary")
  expectedSalary     String?   @map("expected_salary")
  noticePeriod       String?   @map("notice_period")
  preferredJobTypes  Json?     @map("preferred_job_types")
  preferredRoles     Json?     @map("preferred_roles")
  workPreference     String?   @map("work_preference") @db.VarChar(20)
  onboardingStep     String    @default("welcome") @map("onboarding_step") @db.VarChar(40)
  onboardingData     Json?     @map("onboarding_data")
  isComplete         Boolean   @default(false) @map("is_complete")
  masterResumeId     Int?      @map("master_resume_id")
  digestOptOut       Boolean   @default(false) @map("digest_opt_out")
  autoApplyConsent   Boolean   @default(false) @map("auto_apply_consent")
  autoApplyConsentAt DateTime? @map("auto_apply_consent_at")
  interviewPreferences Json?   @map("interview_preferences")
  // Job seeker subscription (Razorpay — paid by candidate, not operator)
  trialEndsAt              DateTime  @map("trial_ends_at")
  subscriptionStatus       String    @default("trial") @map("subscription_status") @db.VarChar(32)
  subscriptionPlan         String?   @map("subscription_plan") @db.VarChar(20)
  razorpayCustomerId       String?   @map("razorpay_customer_id") @db.VarChar(64)
  razorpaySubscriptionId   String?   @map("razorpay_subscription_id") @db.VarChar(64)
  currentPeriodEnd         DateTime? @map("current_period_end")
  subscriptionCancelAtPeriodEnd Boolean @default(false) @map("subscription_cancel_at_period_end")
  createdAt          DateTime? @default(now()) @map("created_at")
  updatedAt          DateTime? @updatedAt @map("updated_at")

  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact        Contact              @relation(fields: [contactId], references: [id], onDelete: Cascade)
  resumes        CareerResume[]
  jobMatches     CareerJobMatch[]
  matchFeedback  CareerMatchFeedback[]
  applications   CareerApplication[]
  coverLetters   CareerCoverLetter[]
  notifications  CareerNotification[]
  paymentSubmissions PaymentSubmission[]

  @@index([userId, isComplete])
  @@map("career_profiles")
}

model CareerResume {
  id            Int       @id @default(autoincrement())
  userId        Int       @map("user_id")
  profileId     Int       @map("profile_id")
  contactId     Int       @map("contact_id")
  type          String    @default("upload") @db.VarChar(20)
  fileName      String?   @map("file_name")
  mimeType      String?   @map("mime_type")
  filePath      String?   @map("file_path")
  extractedText String?   @map("extracted_text") @db.Text
  extractMeta   Json?     @map("extract_meta")
  isMaster      Boolean   @default(false) @map("is_master")
  createdAt     DateTime? @default(now()) @map("created_at")
  updatedAt     DateTime? @updatedAt @map("updated_at")

  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile  CareerProfile         @relation(fields: [profileId], references: [id], onDelete: Cascade)
  versions CareerResumeVersion[]

  @@index([userId, profileId])
  @@map("career_resumes")
}

model CareerResumeVersion {
  id              Int       @id @default(autoincrement())
  userId          Int       @map("user_id")
  resumeId        Int       @map("resume_id")
  jobId           Int?      @map("job_id")
  title           String?
  content         String?   @db.Text
  filePath        String?   @map("file_path")
  filePathPdf     String?   @map("file_path_pdf")
  filePathDocx    String?   @map("file_path_docx")
  createdAt       DateTime? @default(now()) @map("created_at")

  resume CareerResume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  job    CareerJob?   @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([resumeId, createdAt])
  @@map("career_resume_versions")
}

model CareerJob {
  id            Int       @id @default(autoincrement())
  userId        Int       @map("user_id")
  title         String
  company       String
  location      String?
  salaryMin     Int?      @map("salary_min")
  salaryMax     Int?      @map("salary_max")
  salaryText    String?   @map("salary_text")
  jobType       String?   @map("job_type") @db.VarChar(30)
  description   String?   @db.Text
  requiredSkills Json?    @map("required_skills")
  minExperience Int?      @map("min_experience")
  experienceMax Int?      @map("experience_max")
  tags          Json?
  source        String?   @db.VarChar(50)
  externalId    String?   @map("external_id")
  isActive      Boolean   @default(true) @map("is_active")
  postedAt      DateTime? @map("posted_at")
  expiresAt     DateTime? @map("expires_at")
  city          String?   @db.VarChar(80)
  industry      String?   @db.VarChar(60)
  applyUrl      String?   @map("apply_url")
  createdAt     DateTime? @default(now()) @map("created_at")
  updatedAt     DateTime? @updatedAt @map("updated_at")

  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  matches      CareerJobMatch[]
  matchFeedback CareerMatchFeedback[]
  applications CareerApplication[]
  versions     CareerResumeVersion[]
  coverLetters CareerCoverLetter[]

  @@unique([userId, externalId])
  @@index([userId, isActive])
  @@index([userId, title])
  @@map("career_jobs")
}

model CareerJobMatch {
  id             Int       @id @default(autoincrement())
  userId         Int       @map("user_id")
  profileId      Int       @map("profile_id")
  contactId      Int       @map("contact_id")
  jobId          Int       @map("job_id")
  score          Float
  matchFactors   Json?     @map("match_factors")
  missingSkills  Json?     @map("missing_skills")
  createdAt      DateTime? @default(now()) @map("created_at")

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile CareerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  job     CareerJob     @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([profileId, jobId])
  @@index([userId, profileId, score])
  @@map("career_job_matches")
}

model CareerMatchFeedback {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  profileId Int      @map("profile_id")
  jobId     Int      @map("job_id")
  event     String   @db.VarChar(40)
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile CareerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  job     CareerJob     @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([profileId, event, createdAt])
  @@index([profileId, jobId])
  @@map("career_match_feedback")
}

model CareerApplication {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  profileId  Int       @map("profile_id")
  contactId  Int       @map("contact_id")
  jobId      Int       @map("job_id")
  status     String    @default("saved") @db.VarChar(20)
  timeline   Json?
  notes      String?
  createdAt  DateTime? @default(now()) @map("created_at")
  updatedAt  DateTime? @updatedAt @map("updated_at")

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile CareerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  job     CareerJob     @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([profileId, jobId])
  @@index([userId, status])
  @@map("career_applications")
}

model CareerCoverLetter {
  id           Int       @id @default(autoincrement())
  userId       Int       @map("user_id")
  profileId    Int       @map("profile_id")
  jobId        Int?      @map("job_id")
  content      String    @db.Text
  filePath     String?   @map("file_path")
  filePathPdf  String?   @map("file_path_pdf")
  filePathDocx String?   @map("file_path_docx")
  createdAt    DateTime? @default(now()) @map("created_at")

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile CareerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  job     CareerJob?    @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([userId, profileId])
  @@map("career_cover_letters")
}

model CareerNotification {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  profileId   Int       @map("profile_id")
  contactId   Int       @map("contact_id")
  type        String    @db.VarChar(30)
  status      String    @default("pending") @db.VarChar(20)
  payload     Json?
  scheduledAt DateTime? @map("scheduled_at")
  sentAt      DateTime? @map("sent_at")
  createdAt   DateTime? @default(now()) @map("created_at")

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile CareerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([userId, type, status])
  @@index([scheduledAt, status])
  @@map("career_notifications")
}

model CareerAuditLog {
  id            Int       @id @default(autoincrement())
  userId        Int       @map("user_id")
  profileId     Int?      @map("profile_id")
  applicationId Int?      @map("application_id")
  action        String    @db.VarChar(60)
  actorType     String    @map("actor_type") @db.VarChar(20)
  actorLabel    String?   @map("actor_label") @db.VarChar(120)
  details       Json?
  createdAt     DateTime? @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, action])
  @@map("career_audit_logs")
}

model BillingTransaction {
  id                     Int       @id @default(autoincrement())
  userId                 Int       @map("user_id")
  product                String    @default("platform") @db.VarChar(32)
  eventType              String    @map("event_type") @db.VarChar(64)
  razorpayPaymentId      String?   @map("razorpay_payment_id") @db.VarChar(64)
  razorpaySubscriptionId String?   @map("razorpay_subscription_id") @db.VarChar(64)
  plan                   String?   @db.VarChar(20)
  amountInr              Int       @default(0) @map("amount_inr")
  currency               String    @default("INR") @db.VarChar(8)
  status                 String    @default("captured") @db.VarChar(32)
  metadata               Json?
  createdAt              DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([product, createdAt])
  @@index([razorpayPaymentId])
  @@map("billing_transactions")
}

model PaymentSubmission {
  id                 Int       @id @default(autoincrement())
  userId             Int       @map("user_id")
  profileId          Int?      @map("profile_id")
  product            String    @default("platform") @db.VarChar(32)
  plan               String    @db.VarChar(20)
  amountInr          Int       @map("amount_inr")
  paymentMethod      String    @default("upi_manual") @map("payment_method") @db.VarChar(32)
  upiTransactionId   String    @map("upi_transaction_id") @db.VarChar(64)
  screenshotToken    String    @map("screenshot_token") @db.VarChar(64)
  status             String    @default("pending") @db.VarChar(32)
  rejectionReason    String?   @map("rejection_reason") @db.VarChar(500)
  reviewedByAdminId  Int?      @map("reviewed_by_admin_id")
  reviewedAt         DateTime? @map("reviewed_at")
  metadata           Json?
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile CareerProfile? @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([status, createdAt])
  @@index([upiTransactionId])
  @@index([product, profileId, status])
  @@map("payment_submissions")
}

model PlatformAuditLog {
  id                  Int      @id @default(autoincrement())
  action              String   @db.VarChar(64)
  actorAdminId        Int?     @map("actor_admin_id")
  targetUserId        Int?     @map("target_user_id")
  paymentSubmissionId Int?     @map("payment_submission_id")
  details             Json?
  createdAt           DateTime @default(now()) @map("created_at")

  targetUser User? @relation("PlatformAuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([action, createdAt])
  @@index([targetUserId, createdAt])
  @@map("platform_audit_logs")
}

model IntegrationCredential {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  name       String    @db.VarChar(64)
  label      String?   @db.VarChar(128)
  authType   String    @default("bearer") @map("auth_type") @db.VarChar(32)
  secret     String
  headerName String?   @map("header_name") @db.VarChar(64)
  createdAt  DateTime? @default(now()) @map("created_at")
  updatedAt  DateTime? @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
  @@map("integration_credentials")
}

model ProcessedWebhookEvent {
  id             Int       @id @default(autoincrement())
  source         String    @db.VarChar(32)
  idempotencyKey String    @unique @map("idempotency_key") @db.VarChar(128)
  expiresAt      DateTime? @map("expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([source, createdAt])
  @@index([expiresAt])
  @@map("processed_webhook_events")
}

// --- Marketing Website Lead Capture ---

model WebsiteLead {
  id               Int       @id @default(autoincrement())
  name             String
  email            String
  phone            String
  businessType     String    @map("business_type") @db.VarChar(50)
  companyName      String?   @map("company_name")
  monthlyMessages  Int?      @map("monthly_messages")
  challenge        String?   @db.Text
  source           String    @default("website") @db.VarChar(50)
  status           String    @default("new") @db.VarChar(20)
  score            Int?      @default(0)
  qualification    String?   @default("cold") @db.VarChar(20)
  notes            String?   @db.Text
  demoDate         DateTime? @map("demo_date")
  demoConfirmed    Boolean   @default(false) @map("demo_confirmed")
  confirmationToken String?  @unique @map("confirmation_token") @db.VarChar(128)
  metadata         Json?
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@unique([email])
  @@index([email])
  @@index([status])
  @@index([businessType])
  @@index([createdAt])
  @@map("website_leads")
}

// --- Interactive Messages for Workflows ---

model InteractiveMessageType {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(50)
  description String?  @db.Text
  maxOptions  Int      @map("max_options")
  createdAt   DateTime @default(now()) @map("created_at")

  templates InteractiveMessageTemplate[]

  @@map("interactive_message_types")
}

model InteractiveMessageTemplate {
  id              Int      @id @default(autoincrement())
  userId          Int      @map("user_id")
  name            String   @db.VarChar(100)
  messageTypeId   Int      @map("message_type_id")
  headerText      String?  @map("header_text") @db.VarChar(1000)
  bodyText        String   @map("body_text") @db.Text
  footerText      String?  @map("footer_text") @db.VarChar(1000)
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user           User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  messageType     InteractiveMessageType        @relation(fields: [messageTypeId], references: [id], onDelete: Cascade)
  options        InteractiveMessageOption[]
  workflowNodes  WorkflowNode[]

  @@index([userId])
  @@index([messageTypeId])
  @@map("interactive_message_templates")
}

model InteractiveMessageOption {
  id          Int      @id @default(autoincrement())
  templateId  Int      @map("template_id")
  optionText  String   @map("option_text") @db.VarChar(100)
  description String?  @db.VarChar(500)
  nextNodeId  String?  @map("next_node_id") @db.VarChar(100)
  displayOrder Int      @map("display_order")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  template InteractiveMessageTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@map("interactive_message_options")
}

model WorkflowNode {
  id                    Int      @id @default(autoincrement())
  workflowId            Int      @map("workflow_id")
  nodeId                String   @map("node_id") @db.VarChar(100)
  nodeType              String   @map("node_type") @db.VarChar(50)
  messageType           String   @default("TEXT") @map("message_type") @db.VarChar(20)
  interactiveTemplateId Int?     @map("interactive_template_id")
  config                Json?
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  workflow               Workflow                      @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  interactiveTemplate    InteractiveMessageTemplate?   @relation(fields: [interactiveTemplateId], references: [id], onDelete: SetNull)

  @@unique([workflowId, nodeId])
  @@index([workflowId])
  @@index([interactiveTemplateId])
  @@map("workflow_nodes")
}

model UserWorkflowState {
  id                Int       @id @default(autoincrement())
  userId            Int       @map("user_id")
  phoneNumber       String    @map("phone_number") @db.VarChar(20)
  workflowId        Int       @map("workflow_id")
  currentNodeId     String    @map("current_node_id") @db.VarChar(100)
  status            String    @default("ACTIVE") @db.VarChar(20)
  lastMessageSentAt DateTime? @map("last_message_sent_at")
  metadata          Json?
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, phoneNumber])
  @@index([phoneNumber])
  @@index([workflowId])
  @@index([userId])
  @@map("user_workflow_states")
}

model ButtonClickAnalytics {
  id            Int      @id @default(autoincrement())
  templateId    Int      @map("template_id")
  optionId      Int      @map("option_id")
  phoneNumber   String   @map("phone_number") @db.VarChar(20)
  workflowId    Int      @map("workflow_id")
  clickedAt     DateTime @default(now()) @map("clicked_at")
  responseTimeMs Int?     @map("response_time_ms")

  @@index([templateId])
  @@index([optionId])
  @@index([clickedAt])
  @@map("button_click_analytics")
}

// --- Availability engine (v4 Release B) ---

model ServiceResource {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  name      String   @db.VarChar(120)
  type      String   @db.VarChar(32)
  isActive  Boolean  @default(true) @map("is_active")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  schedules ResourceSchedule[]
  bookings  Booking[]

  @@index([userId, isActive])
  @@map("service_resources")
}

model ResourceSchedule {
  id          Int      @id @default(autoincrement())
  resourceId  Int      @map("resource_id")
  dayOfWeek   Int      @map("day_of_week")
  startTime   String   @map("start_time") @db.VarChar(5)
  endTime     String   @map("end_time") @db.VarChar(5)
  slotMinutes Int      @default(30) @map("slot_minutes")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  resource ServiceResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([resourceId, dayOfWeek])
  @@index([resourceId, isActive])
  @@map("resource_schedules")
}

model Booking {
  id                  Int       @id @default(autoincrement())
  userId              Int       @map("user_id")
  resourceId          Int       @map("resource_id")
  contactId           Int?      @map("contact_id")
  conversationId      Int?      @map("conversation_id")
  workflowExecutionId Int?      @map("workflow_execution_id")
  startsAt            DateTime  @map("starts_at")
  endsAt              DateTime  @map("ends_at")
  status              String    @default("confirmed") @db.VarChar(20)
  serviceLabel        String?   @map("service_label") @db.VarChar(120)
  notes               String?
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource          ServiceResource    @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  contact           Contact?           @relation(fields: [contactId], references: [id], onDelete: SetNull)
  conversation      Conversation?      @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  workflowExecution WorkflowExecution? @relation(fields: [workflowExecutionId], references: [id], onDelete: SetNull)

  @@index([userId, startsAt])
  @@index([resourceId, startsAt])
  @@index([userId, status])
  @@map("bookings")
}

model OwnerNotification {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  type      String    @db.VarChar(40)
  title     String    @db.VarChar(160)
  body      String
  metadata  Json?
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([userId, createdAt])
  @@map("owner_notifications")
}

model PushDeviceToken {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  expoPushToken String  @map("expo_push_token") @db.VarChar(255)
  platform     String   @db.VarChar(16)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([expoPushToken])
  @@index([userId])
  @@map("push_device_tokens")
}

// Catalog / brochure mini-site (one per user). Public at {WEBSITE_URL}/c/{slug}.
model CatalogSite {
  id              Int       @id @default(autoincrement())
  userId          Int       @unique @map("user_id")
  slug            String    @unique @db.VarChar(64)
  businessName    String    @map("business_name") @db.VarChar(160)
  tagline         String?   @db.VarChar(255)
  status          String    @default("draft") @db.VarChar(20)
  theme           Json?
  contactPhone    String?   @map("contact_phone") @db.VarChar(30)
  contactEmail    String?   @map("contact_email") @db.VarChar(160)
  contactWhatsapp String?   @map("contact_whatsapp") @db.VarChar(30)
  address         String?
  publishedAt     DateTime? @map("published_at")
  // Merchant checkout (catalog commerce) — per-business UPI QR, not platform billing
  paymentQrMediaId    Int?     @map("payment_qr_media_id")
  paymentUpiVpa       String?  @map("payment_upi_vpa") @db.VarChar(80)
  paymentUpiPayeeName String?  @map("payment_upi_payee_name") @db.VarChar(120)
  paymentsEnabled     Boolean  @default(false) @map("payments_enabled")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sections CatalogSection[]
  media    CatalogMedia[]
  products CatalogProduct[]
  orders   CatalogOrder[]

  @@index([status])
  @@map("catalog_sites")
}

model CatalogSection {
  id        Int      @id @default(autoincrement())
  siteId    Int      @map("site_id")
  type      String   @db.VarChar(32)
  title     String?  @db.VarChar(160)
  enabled   Boolean  @default(true)
  sortOrder Int      @default(0) @map("sort_order")
  config    Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  site  CatalogSite    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  media CatalogMedia[]

  @@unique([siteId, type])
  @@index([siteId, sortOrder])
  @@map("catalog_sections")
}

model CatalogMedia {
  id          Int      @id @default(autoincrement())
  siteId      Int      @map("site_id")
  sectionId   Int?     @map("section_id")
  kind        String   @default("image") @db.VarChar(20)
  storageKey  String   @map("storage_key") @db.VarChar(512)
  url         String
  fileName    String?  @map("file_name") @db.VarChar(255)
  mimeType    String?  @map("mime_type") @db.VarChar(120)
  sizeBytes   Int?     @map("size_bytes")
  alt         String?  @db.VarChar(255)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  site     CatalogSite      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  section  CatalogSection?  @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  products CatalogProduct[]
  orderScreenshots CatalogOrder[] @relation("CatalogOrderScreenshot")

  @@index([siteId, kind])
  @@index([sectionId, sortOrder])
  @@map("catalog_media")
}

model CatalogProduct {
  id            Int      @id @default(autoincrement())
  siteId        Int      @map("site_id")
  name          String   @db.VarChar(160)
  description   String?
  priceAmount   Decimal? @map("price_amount") @db.Decimal(12, 2)
  priceCurrency String   @default("INR") @map("price_currency") @db.VarChar(8)
  imageMediaId  Int?     @map("image_media_id")
  sortOrder     Int      @default(0) @map("sort_order")
  isActive      Boolean  @default(true) @map("is_active")
  /// Inventory for catalog commerce (Phase 1). 0 = out of stock.
  stockQuantity Int      @default(0) @map("stock_quantity")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  site  CatalogSite   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  image CatalogMedia? @relation(fields: [imageMediaId], references: [id], onDelete: SetNull)
  orders CatalogOrder[]

  @@index([siteId, sortOrder])
  @@index([siteId, isActive, stockQuantity])
  @@map("catalog_products")
}

/// Catalog commerce order (Phase 3). Qty=1 in v1; stock deducts only on owner confirm.
model CatalogOrder {
  id                       Int       @id @default(autoincrement())
  orderNumber              String    @unique @map("order_number") @db.VarChar(32)
  userId                   Int       @map("user_id")
  siteId                   Int       @map("site_id")
  contactId                Int?      @map("contact_id")
  customerPhone            String?   @map("customer_phone") @db.VarChar(30)
  customerName             String?   @map("customer_name") @db.VarChar(160)
  productId                Int?      @map("product_id")
  productName              String    @map("product_name") @db.VarChar(160)
  productPrice             Decimal?  @map("product_price") @db.Decimal(12, 2)
  productImageMediaId      Int?      @map("product_image_media_id")
  quantity                 Int       @default(1)
  amountInr                Decimal   @map("amount_inr") @db.Decimal(12, 2)
  paymentStatus            String    @map("payment_status") @db.VarChar(32)
  orderStatus              String    @map("order_status") @db.VarChar(32)
  paymentScreenshotMediaId Int?      @map("payment_screenshot_media_id")
  verifiedAt               DateTime? @map("verified_at")
  verifiedByUserId         Int?      @map("verified_by_user_id")
  rejectionReason          String?   @map("rejection_reason") @db.VarChar(500)
  notes                    String?
  conversationId           Int?      @map("conversation_id")
  workflowExecutionId      Int?      @map("workflow_execution_id")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  site               CatalogSite     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  contact            Contact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)
  product            CatalogProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
  paymentScreenshot  CatalogMedia?   @relation("CatalogOrderScreenshot", fields: [paymentScreenshotMediaId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([userId, orderStatus, createdAt])
  @@index([userId, paymentStatus, createdAt])
  @@index([siteId, createdAt])
  @@map("catalog_orders")
}
