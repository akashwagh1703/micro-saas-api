# Application
NODE_ENV=development
PORT=3000
APP_URL=https://api.autowave.playltp.in

# PostgreSQL connection string used by Prisma (and pg-boss when QUEUE_DRIVER=pgboss).
DATABASE_URL=postgresql://autowave_user:AutoWave1703@localhost:5432/autowave
DIRECT_URL=postgresql://autowave_user:AutoWave1703@localhost:5432/autowave

# Background work driver:
#   pgboss = in-process PostgreSQL queue + worker (always-on hosts: Render, Docker, local)
#   sync   = run jobs inline during the request (serverless hosts: Vercel)
QUEUE_DRIVER=sync

# 32-byte key (base64 or hex) used to encrypt WhatsApp/AI secrets at rest (AES-256-GCM).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=giLsWWud7WITnInvn5lQUfN9cMsUoVajY26toOM1Z0w=

# bcrypt cost factor for password hashing.
BCRYPT_ROUNDS=12

# WhatsApp Cloud API
WHATSAPP_GRAPH_VERSION=v21.0

# AI defaults (per-user keys are stored encrypted in user_settings)
AI_DEFAULT_PROVIDER=openrouter
AI_DEFAULT_MODEL=nvidia/nemotron-3.5-content-safety:free

# CareerAI Bot — resume storage and daily digest (business type: career_ai)
CAREER_STORAGE_PATH=./storage/career
CAREER_DIGEST_ENABLED=true
CAREER_DIGEST_TIMEZONE=Asia/Kolkata
CAREER_DIGEST_HOUR=8
CAREER_DIGEST_HOUR_UTC=8
# Max CareerAI bot WhatsApp replies per contact per minute (default 20)
CAREER_RATE_LIMIT_PER_MINUTE=20

# CareerAI Bot — Adzuna real job listings (free tier: 250 req/day, covers India)
# Register at: https://developer.adzuna.com/
# Leave blank to disable live job fetching (bot falls back to 5 seed jobs).
ADZUNA_APP_ID=14e277a5
ADZUNA_APP_KEY=9006f236c745db8b7f3205db6d1e1943

# CareerAI — MinIO object storage for resumes (S3-compatible API)
# MINIO_ENDPOINT must use port 9000 (S3 API), not 9001 (web console).
MINIO_ENDPOINT=http://168.144.121.155:9000
MINIO_FORCE_PATH_STYLE=true
MINIO_BUCKET=autowave-docs
MINIO_ACCESS_KEY=autowave_root
MINIO_SECRET_KEY=AutoWave@1703
MINIO_REGION=us-east-1

# Platform billing (14-day trial, then Razorpay monthly/yearly)
# Set BILLING_ENABLED=true in production once Razorpay is configured.
BILLING_ENABLED=true
BILLING_TRIAL_DAYS=14
PLATFORM_PRICE_MONTHLY_INR=499
PLATFORM_PRICE_YEARLY_INR=4999

# Razorpay — create two subscription plans in Razorpay Dashboard, paste plan IDs here.
# Webhook URL: {APP_URL}/api/webhook/razorpay
RAZORPAY_KEY_ID=rzp_test_SvXMOmyuqNNeYf
RAZORPAY_KEY_SECRET=FafHDBLQHYD1CwYv2y0dOT9h
RAZORPAY_WEBHOOK_SECRET=flowchat-verify
RAZORPAY_PLAN_MONTHLY=plan_SvXV1MEDaJkNhg
RAZORPAY_PLAN_YEARLY=plan_SvXWTs7CPC0Pvo