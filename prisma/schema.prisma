generator client {
  provider      = "prisma-client-js"
  // "native" for local dev; "rhel-openssl-3.0.x" for Vercel/AWS Lambda runtime.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  // Pooled connection (e.g. Neon pooler) used by the app at runtime.
  url       = env("DATABASE_URL")
  // Direct (non-pooled) connection used for migrations. Falls back to DATABASE_URL
  // when DIRECT_URL is unset (e.g. local dev / Render).
  directUrl = env("DIRECT_URL")
}

model User {
  id              Int       @id @default(autoincrement())
  name            String
  email           String    @unique
  emailVerifiedAt DateTime? @map("email_verified_at")
  password        String
  rememberToken   String?   @map("remember_token") @db.VarChar(100)
  createdAt       DateTime? @default(now()) @map("created_at")
  updatedAt       DateTime? @updatedAt @map("updated_at")

  // Platform billing (14-day trial, then Razorpay monthly/yearly)
  trialEndsAt            DateTime  @map("trial_ends_at")
  subscriptionStatus     String    @default("trial") @map("subscription_status") @db.VarChar(20)
  subscriptionPlan       String?   @map("subscription_plan") @db.VarChar(20)
  razorpayCustomerId     String?   @map("razorpay_customer_id") @db.VarChar(64)
  razorpaySubscriptionId String?   @map("razorpay_subscription_id") @db.VarChar(64)
  currentPeriodEnd       DateTime? @map("current_period_end")
  subscriptionCancelAtPeriodEnd Boolean @default(false) @map("subscription_cancel_at_period_end")

  whatsAppAccount     WhatsAppAccount?
  instagramAccount    InstagramAccount?
  contacts            Contact[]
  conversations       Conversation[]
  messages            Message[]
  workflows           Workflow[]
  workflowExecutions  WorkflowExecution[]
  settings            UserSetting[]
  activities          Activity[]
  tokens              PersonalAccessToken[]
  leads               Lead[]
  careerProfiles      CareerProfile[]
  careerResumes       CareerResume[]
  careerJobs          CareerJob[]
  careerJobMatches    CareerJobMatch[]
  careerMatchFeedback CareerMatchFeedback[]
  careerApplications  CareerApplication[]
  careerCoverLetters  CareerCoverLetter[]
  careerNotifications CareerNotification[]
  careerAuditLogs     CareerAuditLog[]
  billingTransactions BillingTransaction[]
  integrationCredentials IntegrationCredential[]

  @@map("users")
}

model PersonalAccessToken {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  name       String
  token      String    @unique @db.VarChar(64)
  abilities  String?
  lastUsedAt DateTime? @map("last_used_at")
  expiresAt  DateTime? @map("expires_at")
  createdAt  DateTime? @default(now()) @map("created_at")
  updatedAt  DateTime? @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("personal_access_tokens")
}

model WhatsAppAccount {
  id                 Int       @id @default(autoincrement())
  userId             Int       @unique @map("user_id")
  accessToken        String?   @map("access_token")
  phoneNumberId      String?   @map("phone_number_id")
  businessAccountId  String?   @map("business_account_id")
  verifyToken        String?   @map("verify_token")
  appSecret          String?   @map("app_secret")
  displayPhoneNumber String?   @map("display_phone_number")
  isConnected        Boolean   @default(false) @map("is_connected")
  connectedAt        DateTime? @map("connected_at")
  createdAt          DateTime? @default(now()) @map("created_at")
  updatedAt          DateTime? @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@map("whats_app_accounts")
}

model InstagramAccount {
  id              Int       @id @default(autoincrement())
  userId          Int       @unique @map("user_id")
  instagramUserId String?   @map("instagram_user_id")
  pageId          String?   @map("page_id")
  accessToken     String?   @map("access_token")
  verifyToken     String?   @map("verify_token")
  appSecret       String?   @map("app_secret")
  username        String?
  displayName     String?   @map("display_name")
  isConnected     Boolean   @default(false) @map("is_connected")
  connectedAt     DateTime? @map("connected_at")
  createdAt       DateTime? @default(now()) @map("created_at")
  updatedAt       DateTime? @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@map("instagram_accounts")
}

model Contact {
  id              Int       @id @default(autoincrement())
  userId          Int       @map("user_id")
  channel         String    @default("whatsapp") @db.VarChar(20)
  name            String?
  phone           String?
  instagramUserId String?   @map("instagram_user_id")
  username        String?
  email           String?
  tags            Json?
  notes           String?
  lastMessageAt   DateTime? @map("last_message_at")
  createdAt       DateTime? @default(now()) @map("created_at")
  updatedAt       DateTime? @updatedAt @map("updated_at")

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation       Conversation?
  messages           Message[]
  workflowExecutions WorkflowExecution[]
  careerProfile      CareerProfile?

  @@unique([userId, phone])
  @@unique([userId, instagramUserId])
  @@index([userId, channel, lastMessageAt])
  @@index([userId, lastMessageAt])
  @@map("contacts")
}

model Conversation {
  id                  Int       @id @default(autoincrement())
  userId              Int       @map("user_id")
  contactId           Int       @unique @map("contact_id")
  channel             String    @default("whatsapp") @db.VarChar(20)
  whatsAppAccountId   Int?      @map("whats_app_account_id")
  instagramAccountId  Int?      @map("instagram_account_id")
  unreadCount         Int       @default(0) @map("unread_count")
  lastMessageAt       DateTime? @map("last_message_at")
  createdAt           DateTime? @default(now()) @map("created_at")
  updatedAt           DateTime? @updatedAt @map("updated_at")

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact            Contact             @relation(fields: [contactId], references: [id], onDelete: Cascade)
  whatsAppAccount    WhatsAppAccount?    @relation(fields: [whatsAppAccountId], references: [id], onDelete: SetNull)
  instagramAccount   InstagramAccount?   @relation(fields: [instagramAccountId], references: [id], onDelete: SetNull)
  messages           Message[]
  workflowExecutions WorkflowExecution[]

  @@index([userId, channel, lastMessageAt])
  @@index([userId, lastMessageAt])
  @@map("conversations")
}

model Message {
  id                 Int       @id @default(autoincrement())
  userId             Int       @map("user_id")
  conversationId     Int       @map("conversation_id")
  contactId          Int       @map("contact_id")
  channel            String    @default("whatsapp") @db.VarChar(20)
  direction          String
  content            String
  waMessageId        String?   @map("wa_message_id")
  externalMessageId  String?   @map("external_message_id")
  status             String    @default("pending")
  metadata           Json?
  createdAt          DateTime? @default(now()) @map("created_at")
  updatedAt          DateTime? @updatedAt @map("updated_at")

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation       Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  contact            Contact             @relation(fields: [contactId], references: [id], onDelete: Cascade)
  workflowExecutions WorkflowExecution[]

  @@unique([userId, waMessageId])
  @@unique([userId, externalMessageId])
  @@index([conversationId, createdAt])
  @@index([userId, channel, createdAt])
  @@map("messages")
}

model Workflow {
  id               Int       @id @default(autoincrement())
  userId           Int       @map("user_id")
  name             String
  description      String?
  status           String    @default("draft")
  isActive         Boolean   @default(false) @map("is_active")
  triggerType      String    @default("message_received") @map("trigger_type")
  webhookToken     String?   @unique @map("webhook_token") @db.VarChar(64)
  scheduleCron     String?   @map("schedule_cron") @db.VarChar(64)
  scheduleTimezone String?   @default("UTC") @map("schedule_timezone") @db.VarChar(64)
  sourceTemplate   String?   @map("source_template")
  businessCategory String?   @map("business_category")
  useCase          String?   @map("use_case")
  isArchived       Boolean   @default(false) @map("is_archived")
  definition       Json?
  createdAt        DateTime? @default(now()) @map("created_at")
  updatedAt        DateTime? @updatedAt @map("updated_at")

  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  executions WorkflowExecution[]

  @@index([userId, status])
  @@index([userId, sourceTemplate])
  @@index([userId, businessCategory, isArchived])
  @@map("workflows")
}

model WorkflowExecution {
  id             Int       @id @default(autoincrement())
  userId         Int       @map("user_id")
  workflowId     Int       @map("workflow_id")
  contactId      Int?      @map("contact_id")
  conversationId Int?      @map("conversation_id")
  messageId      Int?      @map("message_id")
  status         String    @default("pending")
  context        Json?
  errorMessage   String?   @map("error_message")
  startedAt      DateTime? @map("started_at")
  completedAt    DateTime? @map("completed_at")
  createdAt      DateTime? @default(now()) @map("created_at")
  updatedAt      DateTime? @updatedAt @map("updated_at")

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  workflow     Workflow       @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  contact      Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  conversation Conversation?  @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  message      Message?       @relation(fields: [messageId], references: [id], onDelete: SetNull)
  logs         ExecutionLog[]

  @@index([userId, workflowId, createdAt])
  @@map("workflow_executions")
}

model ExecutionLog {
  id                  Int       @id @default(autoincrement())
  workflowExecutionId Int       @map("workflow_execution_id")
  nodeId              String    @map("node_id")
  nodeType            String    @map("node_type")
  status              String    @default("pending")
  input               Json?
  output              Json?
  errorMessage        String?   @map("error_message")
  durationMs          Int?      @map("duration_ms")
  createdAt           DateTime? @default(now()) @map("created_at")
  updatedAt           DateTime? @updatedAt @map("updated_at")

  execution WorkflowExecution @relation(fields: [workflowExecutionId], references: [id], onDelete: Cascade)

  @@index([workflowExecutionId, createdAt])
  @@map("execution_logs")
}

model UserSetting {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  key         String
  value       String?
  isEncrypted Boolean   @default(false) @map("is_encrypted")
  createdAt   DateTime? @default(now()) @map("created_at")
  updatedAt   DateTime? @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@map("user_settings")
}

model Activity {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  type        String
  title       String
  description String?
  metadata    Json?
  createdAt   DateTime? @default(now()) @map("created_at")
  updatedAt   DateTime? @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("activities")
}

model Lead {
  id               Int       @id @default(autoincrement())
  userId           Int       @map("user_id")
  channel          String    @default("whatsapp") @db.VarChar(20)
  status           String    @default("new") @db.VarChar(20)
  contactId        Int?      @map("contact_id")
  conversationId   Int?      @map("conversation_id")
  workflowId       Int?      @map("workflow_id")
  executionId      Int?      @map("execution_id")
  name             String?
  phone            String?
  username         String?
  sourceMessage    String?   @map("source_message")
  collected        Json?
  notes            String?
  createdAt        DateTime? @default(now()) @map("created_at")
  updatedAt        DateTime? @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
  @@index([userId, channel, createdAt])
  @@map("leads")
}

// --- CareerAI Bot (business type: career_ai) ---

model CareerProfile {
  id                 Int       @id @default(autoincrement())
  userId             Int       @map("user_id")
  contactId          Int       @unique @map("contact_id")
  fullName           String?   @map("full_name")
  email              String?
  phone              String?
  experience         Json?
  skills             Json?
  education          Json?
  certifications     Json?
  projects           Json?
  languages          Json?
  currentLocation    String?   @map("current_location")
  preferredLocations Json?     @map("preferred_locations")
  currentSalary      String?   @map("current_salary")
  expectedSalary     String?   @map("expected_salary")
  noticePeriod       String?   @map("notice_period")
  preferredJobTypes  Json?     @map("preferred_job_types")
  preferredRoles     Json?     @map("preferred_roles")
  workPreference     String?   @map("work_preference") @db.VarChar(20)
  onboardingStep     String    @default("welcome") @map("onboarding_step") @db.VarChar(40)
  onboardingData     Json?     @map("onboarding_data")
  isComplete         Boolean   @default(false) @map("is_complete")
  masterResumeId     Int?      @map("master_resume_id")
  digestOptOut       Boolean   @default(false) @map("digest_opt_out")
  autoApplyConsent   Boolean   @default(false) @map("auto_apply_consent")
  autoApplyConsentAt DateTime? @map("auto_apply_consent_at")
  interviewPreferences Json?   @map("interview_preferences")
  // Job seeker subscription (Razorpay — paid by candidate, not operator)
  trialEndsAt              DateTime  @map("trial_ends_at")
  subscriptionStatus       String    @default("trial") @map("subscription_status") @db.VarChar(20)
  subscriptionPlan         String?   @map("subscription_plan") @db.VarChar(20)
  razorpayCustomerId       String?   @map("razorpay_customer_id") @db.VarChar(64)
  razorpaySubscriptionId   String?   @map("razorpay_subscription_id") @db.VarChar(64)
  currentPeriodEnd         DateTime? @map("current_period_end")
  subscriptionCancelAtPeriodEnd Boolean @default(false) @map("subscription_cancel_at_period_end")
  createdAt          DateTime? @default(now()) @map("created_at")
  updatedAt          DateTime? @updatedAt @map("updated_at")

  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact        Contact              @relation(fields: [contactId], references: [id], onDelete: Cascade)
  resumes        CareerResume[]
  jobMatches     CareerJobMatch[]
  matchFeedback  CareerMatchFeedback[]
  applications   CareerApplication[]
  coverLetters   CareerCoverLetter[]
  notifications  CareerNotification[]

  @@index([userId, isComplete])
  @@map("career_profiles")
}

model CareerResume {
  id            Int       @id @default(autoincrement())
  userId        Int       @map("user_id")
  profileId     Int       @map("profile_id")
  contactId     Int       @map("contact_id")
  type          String    @default("upload") @db.VarChar(20)
  fileName      String?   @map("file_name")
  mimeType      String?   @map("mime_type")
  filePath      String?   @map("file_path")
  extractedText String?   @map("extracted_text") @db.Text
  extractMeta   Json?     @map("extract_meta")
  isMaster      Boolean   @default(false) @map("is_master")
  createdAt     DateTime? @default(now()) @map("created_at")
  updatedAt     DateTime? @updatedAt @map("updated_at")

  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile  CareerProfile         @relation(fields: [profileId], references: [id], onDelete: Cascade)
  versions CareerResumeVersion[]

  @@index([userId, profileId])
  @@map("career_resumes")
}

model CareerResumeVersion {
  id              Int       @id @default(autoincrement())
  userId          Int       @map("user_id")
  resumeId        Int       @map("resume_id")
  jobId           Int?      @map("job_id")
  title           String?
  content         String?   @db.Text
  filePath        String?   @map("file_path")
  filePathPdf     String?   @map("file_path_pdf")
  filePathDocx    String?   @map("file_path_docx")
  createdAt       DateTime? @default(now()) @map("created_at")

  resume CareerResume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  job    CareerJob?   @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([resumeId, createdAt])
  @@map("career_resume_versions")
}

model CareerJob {
  id            Int       @id @default(autoincrement())
  userId        Int       @map("user_id")
  title         String
  company       String
  location      String?
  salaryMin     Int?      @map("salary_min")
  salaryMax     Int?      @map("salary_max")
  salaryText    String?   @map("salary_text")
  jobType       String?   @map("job_type") @db.VarChar(30)
  description   String?   @db.Text
  requiredSkills Json?    @map("required_skills")
  minExperience Int?      @map("min_experience")
  experienceMax Int?      @map("experience_max")
  tags          Json?
  source        String?   @db.VarChar(50)
  externalId    String?   @map("external_id")
  isActive      Boolean   @default(true) @map("is_active")
  postedAt      DateTime? @map("posted_at")
  expiresAt     DateTime? @map("expires_at")
  city          String?   @db.VarChar(80)
  industry      String?   @db.VarChar(60)
  applyUrl      String?   @map("apply_url")
  createdAt     DateTime? @default(now()) @map("created_at")
  updatedAt     DateTime? @updatedAt @map("updated_at")

  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  matches      CareerJobMatch[]
  matchFeedback CareerMatchFeedback[]
  applications CareerApplication[]
  versions     CareerResumeVersion[]
  coverLetters CareerCoverLetter[]

  @@unique([userId, externalId])
  @@index([userId, isActive])
  @@index([userId, title])
  @@map("career_jobs")
}

model CareerJobMatch {
  id             Int       @id @default(autoincrement())
  userId         Int       @map("user_id")
  profileId      Int       @map("profile_id")
  contactId      Int       @map("contact_id")
  jobId          Int       @map("job_id")
  score          Float
  matchFactors   Json?     @map("match_factors")
  missingSkills  Json?     @map("missing_skills")
  createdAt      DateTime? @default(now()) @map("created_at")

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile CareerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  job     CareerJob     @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([profileId, jobId])
  @@index([userId, profileId, score])
  @@map("career_job_matches")
}

model CareerMatchFeedback {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  profileId Int      @map("profile_id")
  jobId     Int      @map("job_id")
  event     String   @db.VarChar(40)
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile CareerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  job     CareerJob     @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([profileId, event, createdAt])
  @@index([profileId, jobId])
  @@map("career_match_feedback")
}

model CareerApplication {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  profileId  Int       @map("profile_id")
  contactId  Int       @map("contact_id")
  jobId      Int       @map("job_id")
  status     String    @default("saved") @db.VarChar(20)
  timeline   Json?
  notes      String?
  createdAt  DateTime? @default(now()) @map("created_at")
  updatedAt  DateTime? @updatedAt @map("updated_at")

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile CareerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  job     CareerJob     @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([profileId, jobId])
  @@index([userId, status])
  @@map("career_applications")
}

model CareerCoverLetter {
  id           Int       @id @default(autoincrement())
  userId       Int       @map("user_id")
  profileId    Int       @map("profile_id")
  jobId        Int?      @map("job_id")
  content      String    @db.Text
  filePath     String?   @map("file_path")
  filePathPdf  String?   @map("file_path_pdf")
  filePathDocx String?   @map("file_path_docx")
  createdAt    DateTime? @default(now()) @map("created_at")

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile CareerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  job     CareerJob?    @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([userId, profileId])
  @@map("career_cover_letters")
}

model CareerNotification {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  profileId   Int       @map("profile_id")
  contactId   Int       @map("contact_id")
  type        String    @db.VarChar(30)
  status      String    @default("pending") @db.VarChar(20)
  payload     Json?
  scheduledAt DateTime? @map("scheduled_at")
  sentAt      DateTime? @map("sent_at")
  createdAt   DateTime? @default(now()) @map("created_at")

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile CareerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([userId, type, status])
  @@index([scheduledAt, status])
  @@map("career_notifications")
}

model CareerAuditLog {
  id            Int       @id @default(autoincrement())
  userId        Int       @map("user_id")
  profileId     Int?      @map("profile_id")
  applicationId Int?      @map("application_id")
  action        String    @db.VarChar(60)
  actorType     String    @map("actor_type") @db.VarChar(20)
  actorLabel    String?   @map("actor_label") @db.VarChar(120)
  details       Json?
  createdAt     DateTime? @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, action])
  @@map("career_audit_logs")
}

model BillingTransaction {
  id                     Int       @id @default(autoincrement())
  userId                 Int       @map("user_id")
  product                String    @default("platform") @db.VarChar(32)
  eventType              String    @map("event_type") @db.VarChar(64)
  razorpayPaymentId      String?   @map("razorpay_payment_id") @db.VarChar(64)
  razorpaySubscriptionId String?   @map("razorpay_subscription_id") @db.VarChar(64)
  plan                   String?   @db.VarChar(20)
  amountInr              Int       @default(0) @map("amount_inr")
  currency               String    @default("INR") @db.VarChar(8)
  status                 String    @default("captured") @db.VarChar(32)
  metadata               Json?
  createdAt              DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([product, createdAt])
  @@index([razorpayPaymentId])
  @@map("billing_transactions")
}

model IntegrationCredential {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  name       String    @db.VarChar(64)
  label      String?   @db.VarChar(128)
  authType   String    @default("bearer") @map("auth_type") @db.VarChar(32)
  secret     String
  headerName String?   @map("header_name") @db.VarChar(64)
  createdAt  DateTime? @default(now()) @map("created_at")
  updatedAt  DateTime? @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
  @@map("integration_credentials")
}

model ProcessedWebhookEvent {
  id             Int       @id @default(autoincrement())
  source         String    @db.VarChar(32)
  idempotencyKey String    @unique @map("idempotency_key") @db.VarChar(128)
  expiresAt      DateTime? @map("expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([source, createdAt])
  @@index([expiresAt])
  @@map("processed_webhook_events")
}

// --- Marketing Website Lead Capture ---

model WebsiteLead {
  id               Int       @id @default(autoincrement())
  name             String
  email            String
  phone            String
  businessType     String    @db.VarChar(50)
  companyName      String?   @map("company_name")
  monthlyMessages  Int?      @map("monthly_messages")
  challenge        String?   @db.Text
  source           String    @default("website") @db.VarChar(50)
  status           String    @default("new") @db.VarChar(20)
  score            Int?      @default(0)
  qualification    String?   @default("cold") @db.VarChar(20)
  notes            String?   @db.Text
  demoDate         DateTime? @map("demo_date")
  demoConfirmed    Boolean   @default(false) @map("demo_confirmed")
  confirmationToken String?  @unique @map("confirmation_token") @db.VarChar(128)
  metadata         Json?
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@unique([email])
  @@index([email])
  @@index([status])
  @@index([businessType])
  @@index([createdAt])
  @@map("website_leads")
}
